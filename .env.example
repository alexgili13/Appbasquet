# Neon PostgreSQL — connection string (pooled, per a serverless/edge)
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/basketball?sslmode=require"

# Auth.js — genera amb: npx auth secret
AUTH_SECRET=""

# Vercel Blob — es genera automàticament en connectar el projecte a un
# Blob store des del dashboard de Vercel (Storage > Create > Blob)
BLOB_READ_WRITE_TOKEN=""

# URL base de l'aplicació (per a Auth.js en local)
NEXTAUTH_URL="http://localhost:3000"

# Només per al script de seed (npm run db:seed) — usuari admin inicial
SEED_ADMIN_EMAIL="admin@club.cat"
SEED_ADMIN_PASSWORD="canvia-aquesta-contrasenya"
